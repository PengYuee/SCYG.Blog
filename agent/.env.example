# Compose 项目名；并行实例必须使用不同名称，留空时使用 scyg-agent-local。
SCYG_COMPOSE_PROJECT_NAME=
# PostgreSQL 管理员密码。
SCYG_POSTGRES_PASSWORD=
# 管理员数据库 DSN；固定指向 postgres:5432/scyg_agent，密码必须进行 URL 编码。
SCYG_POSTGRES_ADMIN_DATABASE_URL=
# Agent 数据库角色密码；每次 setup 都会通过管理员连接同步。
SCYG_AGENT_DB_PASSWORD=
# Agent 数据库 DSN；固定使用 scyg_agent 角色，密码必须与上一项匹配并进行 URL 编码。
SCYG_AGENT_DATABASE_URL=
# 本机 PostgreSQL 映射端口；留空时使用 5432。
SCYG_POSTGRES_PORT=
# 本机 Agent HTTP 映射端口；留空时使用 8080。
SCYG_AGENT_HTTP_PORT=
# 本机 Agent gRPC 映射端口；留空时使用 9090。
SCYG_AGENT_GRPC_PORT=
# JWT RSA 公钥文件的宿主机绝对路径；只挂载公钥，不要放私钥。
SCYG_AGENT_JWT_PUBLIC_KEY_PATH=
# JWT 签发方标识。
SCYG_AGENT_JWT_ISSUER=
# JWT 受众标识。
SCYG_AGENT_JWT_AUDIENCE=
# Blog 服务主体标识。
SCYG_AGENT_JWT_SERVICE_SUBJECT=
# OpenAI 兼容提供方基础 URL。
SCYG_AGENT_PROVIDER_BASE_URL=
# 提供方 API 密钥，模板不提供可用值。
SCYG_AGENT_PROVIDER_API_KEY=
# 提供方模型名称。
SCYG_AGENT_PROVIDER_MODEL=
# Blog gRPC 服务地址。
SCYG_AGENT_BLOG_GRPC_TARGET=
