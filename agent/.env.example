# Compose 项目名；并行实例必须使用不同名称，留空时使用 scyg-agent-local。
SCYG_COMPOSE_PROJECT_NAME=
# PostgreSQL 管理员密码。
SCYG_POSTGRES_PASSWORD=
# 管理员数据库 DSN；固定指向 postgres:5432/scyg_agent，密码必须进行 URL 编码。
SCYG_POSTGRES_ADMIN_DATABASE_URL=
# Agent 数据库角色密码；每次 setup 都会通过管理员连接同步。
SCYG_AGENT_DB_PASSWORD=
# Agent 数据库 DSN；固定使用 scyg_agent 角色，密码必须与上一项匹配并进行 URL 编码。
SCYG_AGENT_DATABASE_URL=
# 本机 PostgreSQL 映射端口；留空时使用 5432。
SCYG_POSTGRES_PORT=
# 本机 Agent HTTP 映射端口；留空时使用 8080。
SCYG_AGENT_HTTP_PORT=
# Agent gRPC 在 Compose 内部网络固定监听 9090，不发布宿主机端口。
# 服务端模型协议；chat_completions 或 responses。
SCYG_AGENT_MODELS__PROTOCOL=chat_completions
# 三个服务端模型等级必须显式配置；模板不提供可用凭据。
SCYG_AGENT_MODELS__FAST__BASE_URL=
SCYG_AGENT_MODELS__FAST__API_KEY=
SCYG_AGENT_MODELS__FAST__MODEL=
SCYG_AGENT_MODELS__FAST__TIMEOUT_SECONDS=60
SCYG_AGENT_MODELS__STANDARD__BASE_URL=
SCYG_AGENT_MODELS__STANDARD__API_KEY=
SCYG_AGENT_MODELS__STANDARD__MODEL=
SCYG_AGENT_MODELS__STANDARD__TIMEOUT_SECONDS=120
SCYG_AGENT_MODELS__STRONG__BASE_URL=
SCYG_AGENT_MODELS__STRONG__API_KEY=
SCYG_AGENT_MODELS__STRONG__MODEL=
SCYG_AGENT_MODELS__STRONG__TIMEOUT_SECONDS=180
SCYG_AGENT_WORKER_CONCURRENCY=4
# Blog gRPC 服务地址。
SCYG_AGENT_BLOG_GRPC_TARGET=
SCYG_AGENT_REDIS_URL=
SCYG_AGENT_REDIS_TTL_SECONDS=
SCYG_AGENT_REDIS_STREAM_MAXLEN=
SCYG_AGENT_REDIS_CONNECT_TIMEOUT_SECONDS=
SCYG_AGENT_REDIS_READ_TIMEOUT_SECONDS=
SCYG_AGENT_STREAM_FLUSH_CHARS=
SCYG_AGENT_STREAM_FLUSH_INTERVAL_MS=
